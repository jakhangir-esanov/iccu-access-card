{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Iccu.Api"
    }
  },
  "Hangfire": {
    "Dashboard": {
      "Enabled": false,
      "Path": "/hangfire",
      "Title": "ICCU Jobs"
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Clock": {
    "TimeZone": "Asia/Tashkent"
  },
  "Jwt": {
    "Issuer": "iccu-api",
    "Audience": "iccu-admin",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Storage": {
    "RootPath": ""
  },
  "AllowedHosts": "*"
}
